# Copy to .env and fill in. .env is gitignored — never commit credentials.
# Local Neo4j: bolt://localhost:7687 . AuraDB: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j


# Optional: pin the GTFS service window (YYYYMMDD). Leave empty to auto-detect from the feed.
GTFS_CALENDAR_START=
GTFS_CALENDAR_END=
