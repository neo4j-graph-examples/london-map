# Copy to .env.local and fill in. .env.local is gitignored - never commit credentials.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j

# Optional: pin the GTFS service window (YYYYMMDD). Leave empty to auto-detect from the feed.
GTFS_CALENDAR_START=
GTFS_CALENDAR_END=
